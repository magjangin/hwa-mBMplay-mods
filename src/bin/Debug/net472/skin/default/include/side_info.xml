        <image texture="num" x="121" y="90" width="4" height="3" dst_timer="load_complete" loop="0">
          <dst time="0" x="65" y="8" width="4" height ="3" alpha="255" />
        </image>
        <number texture="num" x="0" y="105" width="110" height="11" div_x="11" div_y="1" dst_timer="load_complete" loop="0" value="average_notes_per_second_point" align="left" digit="2">
          <dst time="0" x="69" y="0" width="10" height ="11" alpha="255" />
        </number>

        <dst time="0" x="222" y="337" />
      </group>

      <!-- separater -->
      <image texture="#white" x="0" y="0" width="1" height="1" dst_timer="load_complete" loop="0" condition="autoplay">
        <dst time="0" x="11" y="354" width="300" height ="1" alpha="128" />
      </image>

      <!-- exscore -->
      <group id="exscore" dst_timer="load_complete" loop="0" condition="!autoplay">

        <!-- label -->
        <image texture="common_bg" x="280" y="458" width="31" height="16" dst_timer="load_complete" loop="0">
          <dst time="0" x="0" y="0" width="31" height ="16" alpha="255" />
        </image>

        <!-- value -->
        <number texture="num" x="0" y="0" width="165" height="13" div_x="11" div_y="1" dst_timer="load_complete" loop="0" value="exscore" align="left" digit="5">
          <dst time="0" x="50" y="0" width="15" height ="13" alpha="255" />
        </number>

        <dst time="0" x="11" y="335" />
      </group>

      <!-- score_rate -->
      <group id="score_rate" dst_timer="load_complete" loop="0" condition="!autoplay">

        <image texture="num" x="160" y="82" width="5" height="11" dst_timer="load_complete" loop="0">
          <dst time="0" x="0" y="0" width="5" height ="11" alpha="255" />
        </image>

        <number texture="num" x="0" y="82" width="110" height="11" div_x="11" div_y="1" dst_timer="load_complete" loop="0" value="score_rate" align="left" digit="3">
