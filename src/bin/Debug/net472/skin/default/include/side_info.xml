        </number>
        <image texture="num" x="6" y="41" width="10" height="13" dst_timer="load_complete" loop="0">
          <dst time="0" x="128" y="0" width="10" height ="13" alpha="255" />
        </image>
        <number texture="num" x="0" y="0" width="165" height="13" div_x="11" div_y="1" dst_timer="load_complete" loop="0" value="total_notes" align="left" digit="5">
          <dst time="0" x="141" y="0" width="15" height ="13" alpha="255" />
        </number>

        <dst time="0" x="11" y="318" />
      </group>

      <!-- longnotes -->
      <group id="longnotes" dst_timer="load_complete" loop="0" condition="contains_ln, autoplay">
        <!-- label -->
        <image texture="common_bg" x="354" y="92" width="15" height="7" dst_timer="load_complete" loop="0">
          <dst time="0" x="0" y="2" width="15" height ="7" alpha="255" />
        </image>

        <!-- value -->
        <number texture="num" x="0" y="82" width="110" height="11" div_x="11" div_y="1" dst_timer="load_complete" loop="0" value="total_ln" align="left" digit="5">
          <dst time="0" x="19" y="0" width="10" height ="11" alpha="255" />
        </number>

        <dst time="0" x="242" y="320" />
      </group>

      <!-- notes_per_sec -->
      <group id="notes_per_sec" dst_timer="load_complete" loop="0" condition="autoplay">

        <!-- label -->
        <image texture="common_bg" x="124" y="438" width="41" height="15" dst_timer="load_complete" loop="0">
          <dst time="0" x="0" y="0" width="41" height ="15" alpha="255" />
        </image>

        <!-- value -->
        <number texture="num" x="0" y="0" width="165" height="13" div_x="11" div_y="1" dst_timer="load_complete" loop="0" value="notes_per_second" align="left" digit="4">
          <dst time="0" x="65" y="0" width="15" height ="13" alpha="255" />
        </number>

        <!-- value_highlight -->
        <number texture="num" x="0" y="128" width="150" height="13" div_x="10" div_y="1" dst_timer="nps_max_update" loop="-1" value="notes_per_second" align="right" digit="4">
          <dst time="0" x="65" y="0" width="15" height ="13" alpha="192" />
          <dst time="200" alpha="0" />
        </number>        
        
        <dst time="0" x="11" y="335" />
      </group>

      <!-- max_notes_per_sec -->
      <group id="max_notes_per_sec" dst_timer="load_complete" loop="0" condition="autoplay">

        <!-- label -->
        <image texture="common_bg" x="169" y="438" width="18" height="15" dst_timer="load_complete" loop="0">
          <dst time="0" x="0" y="0" width="18" height ="15" alpha="255" />
        </image>

        <!-- value -->
        <number texture="num" x="0" y="82" width="110" height="11" div_x="11" div_y="1" dst_timer="load_complete" loop="0" value="max_notes_per_second" align="left" digit="4">
          <dst time="0" x="24" y="0" width="10" height ="11" alpha="255" />
        </number>

        <!-- value_highlight -->
        <number texture="num" x="0" y="142" width="100" height="11" div_x="10" div_y="1" dst_timer="nps_max_update" loop="-1" value="max_notes_per_second" align="right" digit="4">
          <dst time="0" x="24" y="0" width="10" height ="11" alpha="192" />
          <dst time="200" alpha="0" />
        </number>

        <dst time="0" x="150" y="337" />
      </group>

      <!-- average_notes_per_sec -->
      <group id="average_notes_per_sec" dst_timer="load_complete" loop="0" condition="autoplay">
        <!-- label -->
        <image texture="common_bg" x="191" y="438" width="18" height="15" dst_timer="load_complete" loop="0">
          <dst time="0" x="0" y="0" width="18" height ="15" alpha="255" />
        </image>

        <!-- value -->
        <number texture="num" x="0" y="82" width="110" height="11" div_x="11" div_y="1" dst_timer="load_complete" loop="0" value="average_notes_per_second" align="left" digit="4">
