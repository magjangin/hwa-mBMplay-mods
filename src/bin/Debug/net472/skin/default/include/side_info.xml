      <var id="gauge_total_alpha" type="int" />
      <if condition="!total_defined">
        <set id="gauge_total_alpha" value="64" />
      </if>
      <else>
        <set id="gauge_total_alpha" value="255" />
      </else>

      <!-- gauge_total_auto -->
      <group id="gauge_total_auto" dst_timer="load_complete" loop="0" condition="autoplay">

