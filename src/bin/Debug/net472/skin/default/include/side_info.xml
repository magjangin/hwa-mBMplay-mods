        <number texture="common_bg" x="379" y="158" width="77" height="7" div_x="11" div_y="1" dst_timer="load_complete" loop="0" value="slow_count_without_pgreat" align="left" digit="5">
          <dst time="0" x="178" y="0" width="7" height ="7" alpha="255" />
