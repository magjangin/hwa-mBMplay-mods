<?xml version="1.0" encoding="utf-8" ?>

<!-- side_info -->

<skin type="include">
  <body>

    <var id="layout_side_info" type="int" value="0" />
    <if condition="$_option[layout][layout_right]">
      <set id="layout_side_info" value="-1" />
    </if>
    <elseif condition="$_option[layout][layout_separate]">
      <set id="layout_side_info" value="239" />
    </elseif>
    <else>
      <set id="layout_side_info" value="479" />
    </else>

    <!-- side_info -->
    <group id="side_info" dst_timer="load_complete" loop="0">

      <!-- bg -->
      <image texture="common_bg" x="163" y="255" width="322" height="1" dst_timer="load_complete" loop="0">
        <dst time="0" x="0" y="0" width="322" height ="256" alpha="255" />
      </image>
      <image texture="common_bg" x="163" y="256" width="322" height="163" dst_timer="load_complete" loop="0">
        <dst time="0" x="0" y="256" width="322" height ="163" alpha="255" />
      </image>

      <!-- bga -->
      <bga dst_timer="load_complete" loop="0">
        <dst time="0" x="33" y="0" width="256" height ="256" alpha="255" />
      </bga>

      <!-- playlevel -->
      <group id="playlevel" dst_timer="load_complete" loop="0">

        <!-- label -->
        <image texture="common_bg" x="4" y="438" width="21" height="15" dst_timer="load_complete" loop="0">
          <dst time="0" x="0" y="0" width="21" height ="15" alpha="255" />
        </image>

        <!-- value -->
        <!-- beginner / easy -->
        <number texture="num" x="197" y="0" width="150" height="13" div_x="10" div_y="1" dst_timer="load_complete" loop="0" value="playlevel" align="left" digit="0" condition="difficulty_1">
          <dst time="0" x="35" y="0" width="15" height ="13" alpha="255" />
        </number>
        <!-- normal -->
        <number texture="num" x="197" y="14" width="150" height="13" div_x="10" div_y="1" dst_timer="load_complete" loop="0" value="playlevel" align="left" digit="0" condition="difficulty_2">
          <dst time="0" x="35" y="0" width="15" height ="13" alpha="255" />
        </number>
        <!-- hyper -->
        <number texture="num" x="197" y="28" width="150" height="13" div_x="10" div_y="1" dst_timer="load_complete" loop="0" value="playlevel" align="left" digit="0" condition="difficulty_3">
          <dst time="0" x="35" y="0" width="15" height ="13" alpha="255" />
        </number>
        <!-- another / ex -->
        <number texture="num" x="197" y="42" width="150" height="13" div_x="10" div_y="1" dst_timer="load_complete" loop="0" value="playlevel" align="left" digit="0" condition="difficulty_4">
          <dst time="0" x="35" y="0" width="15" height ="13" alpha="255" />
        </number>
        <!-- insane -->
        <number texture="num" x="197" y="56" width="150" height="13" div_x="10" div_y="1" dst_timer="load_complete" loop="0" value="playlevel" align="left" digit="0" condition="difficulty_5">
          <dst time="0" x="35" y="0" width="15" height ="13" alpha="255" />
        </number>
        <!-- undefined -->
        <number texture="num" x="0" y="0" width="150" height="13" div_x="10" div_y="1" dst_timer="load_complete" loop="0" value="playlevel" align="left" digit="0" condition="!difficulty_defined">
          <dst time="0" x="35" y="0" width="15" height ="13" alpha="255" />
        </number>

        <dst time="0" x="11" y="262" />
      </group>

      <!-- judge_rank -->
      <var id="judge_rank_alpha" type="int" />
      <if condition="!judge_rank_defined">
        <set id="judge_rank_alpha" value="64" />
      </if>
      <else>
        <set id="judge_rank_alpha" value="255" />
      </else>
      
      <group id="judge_rank" dst_timer="load_complete" loop="0">
        <!-- label -->
        <image texture="common_bg" x="29" y="438" width="21" height="15" dst_timer="load_complete" loop="0">
          <dst time="0" x="0" y="0" width="21" height ="15" alpha="255" />
        </image>

        <!-- value -->
        <image texture="common_bg" x="4" y="458" width="48" height="16" dst_timer="load_complete" loop="0" condition="judge_rank_easy">
          <dst time="0" x="32" y="0" width="48" height ="16" alpha="$judge_rank_alpha" />
        </image>
        <image texture="common_bg" x="56" y="458" width="65" height="16" dst_timer="load_complete" loop="0" condition="judge_rank_normal">
          <dst time="0" x="32" y="0" width="65" height ="16" alpha="$judge_rank_alpha" />
        </image>
        <image texture="common_bg" x="125" y="458" width="60" height="16" dst_timer="load_complete" loop="0" condition="judge_rank_hard">
          <dst time="0" x="32" y="0" width="60" height ="16" alpha="$judge_rank_alpha" />
        </image>
        <image texture="common_bg" x="189" y="458" width="87" height="16" dst_timer="load_complete" loop="0" condition="judge_rank_veryhard">
          <dst time="0" x="32" y="0" width="87" height ="16" alpha="$judge_rank_alpha" />
        </image>

        <dst time="0" x="185" y="261" />
      </group>

      <!-- separater -->
      <image texture="#white" x="0" y="0" width="1" height="1" dst_timer="load_complete" loop="0">
        <dst time="0" x="11" y="281" width="300" height ="1" alpha="128" />
      </image>

      <!-- bpm -->
      <group id="bpm" dst_timer="load_complete" loop="0">

        <!-- label -->
        <image texture="common_bg" x="322" y="108" width="19" height="7" dst_timer="load_complete" loop="0">
          <dst time="0" x="0" y="3" width="19" height ="7" alpha="255" />
        </image>

        <!-- value -->
        <number texture="num" x="0" y="0" width="180" height="26" div_x="12" div_y="2" dst_timer="load_complete" loop="0" value="bpm" align="left" digit="0">
          <dst time="0" x="35" y="0" width="15" height ="13" alpha="255" />
        </number>

        <dst time="0" x="11" y="290" />
      </group>

      <!-- minbpm -->
      <group id="minbpm" dst_timer="load_complete" loop="0" condition="bpm_variable">

        <!-- label -->
        <image texture="common_bg" x="213" y="438" width="18" height="15" dst_timer="load_complete" loop="0">
          <dst time="0" x="0" y="0" width="18" height ="15" alpha="255" />
        </image>

        <!-- value -->
        <number texture="num" x="0" y="82" width="120" height="22" div_x="12" div_y="2" dst_timer="load_complete" loop="0" value="min_bpm" align="right" digit="0">
          <dst time="0" x="108" y="0" width="10" height ="11" alpha="255" />
        </number>

        <dst time="0" x="193" y="284" />
      </group>

      <!-- maxbpm -->
      <group id="maxbpm" dst_timer="load_complete" loop="0" condition="bpm_variable">

        <!-- label -->
        <image texture="common_bg" x="169" y="438" width="18" height="15" dst_timer="load_complete" loop="0">
          <dst time="0" x="0" y="0" width="18" height ="15" alpha="255" />
        </image>

        <!-- value -->
        <number texture="num" x="0" y="82" width="120" height="22" div_x="12" div_y="2" dst_timer="load_complete" loop="0" value="max_bpm" align="right" digit="0">
          <dst time="0" x="108" y="0" width="10" height ="11" alpha="255" />
        </number>

        <dst time="0" x="193" y="298" />
      </group>

      <!-- separater -->
      <image texture="#white" x="0" y="0" width="1" height="1" dst_timer="load_complete" loop="0">
        <dst time="0" x="11" y="311" width="300" height ="1" alpha="128" />
      </image>

      <!-- notes -->
      <group id="notes" dst_timer="load_complete" loop="0">

        <!-- label -->
        <image texture="common_bg" x="54" y="438" width="21" height="15" dst_timer="load_complete" loop="0" condition="autoplay">
          <dst time="0" x="0" y="0" width="21" height ="15" alpha="255" />
        </image>
        <image texture="common_bg" x="79" y="438" width="41" height="15" dst_timer="load_complete" loop="0" condition="!autoplay">
