          <dst time="0" x="216" y="0" width="15" height ="7" alpha="255" />
        </image>
        <number texture="common_bg" x="379" y="158" width="77" height="7" div_x="11" div_y="1" dst_timer="load_complete" loop="0" value="poor" align="left" digit="5">
          <dst time="0" x="232" y="0" width="7" height ="7" alpha="255" />
        </number>

        <dst time="0" x="43" y="352" />
      </group>

      <!-- judge_timing -->
      <group id="judge_timing" dst_timer="load_complete" loop="0" condition="!autoplay">

        <!-- average_judge_timing -->
        <image texture="common_bg" x="215" y="1" width="59" height="7" dst_timer="load_complete" loop="0">
          <dst time="0" x="0" y="0" width="59" height ="7" alpha="255" />
        </image>
        <number texture="common_bg" x="379" y="174" width="84" height="14" div_x="12" div_y="2" dst_timer="load_complete" loop="0" value="average_judge_timing" align="left" digit="3">
