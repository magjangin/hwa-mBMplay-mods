        <image texture="num" x="166" y="82" width="5" height="11" dst_timer="load_complete" loop="0">
          <dst time="0" x="71" y="0" width="5" height ="11" alpha="255" />
        </image>

        <dst time="0" x="146" y="337" />
      </group>

      <!-- combo_break -->
      <group id="combo_break" dst_timer="load_complete" loop="0" condition="!autoplay">

        <!-- label -->
        <image texture="common_bg" x="475" y="150" width="15" height="7" dst_timer="load_complete" loop="0">
          <dst time="0" x="0" y="2" width="15" height ="7" alpha="255" />
